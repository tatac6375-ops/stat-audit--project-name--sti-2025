     "output_type": "stream",
     "text": [
      "=== HASIL MONTE CARLO SIMULATION ===\n",
      "Estimasi P(duration > 30 hari) : 0.667680\n",
      "Jumlah trial                   : 50,000\n",
      "Jumlah kejadian True (sukses)  : 33,384\n",
      "Standard Error estimasi        : 0.002107\n",
